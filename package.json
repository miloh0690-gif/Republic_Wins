{
  "name": "republic-wings-pos",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor proxy seguro para el POS de Republic Wings (multi-sucursal). Guarda las claves y la URL de Google Apps Script fuera del navegador.",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "hash": "node server.js --hash",
    "secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  }
}
